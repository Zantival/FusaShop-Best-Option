APP_NAME=FusaShop
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Bogota
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fusashop
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file

MAIL_MAILER=failover
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="${APP_NAME}"

# --- Resend (correo transaccional: verificación, promociones, facturas y pedidos) ---
RESEND_API_KEY=

# --- Google OAuth 2.0 (inicio de sesión con Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# --- Wompi (sandbox: llaves pub_test_/prv_test_; produccion: pub_prod_/prv_prod_) ---
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
# Webhook a registrar en el panel de Wompi: {APP_URL}/api/webhooks/wompi

# --- Envia.com (sandbox: api-test.envia.com) ---
ENVIA_ENV=sandbox
ENVIA_API_TOKEN=
ENVIA_DEFAULT_CARRIER=servientrega
ENVIA_WEBHOOK_SECRET=
# Webhook de rastreo: POST {APP_URL}/api/webhooks/envia  (header X-Webhook-Secret)
ENVIA_ORIGIN_NAME="FusaShop"
ENVIA_ORIGIN_EMAIL=despachos@fusashop.com
ENVIA_ORIGIN_PHONE=3000000000
ENVIA_ORIGIN_STREET="Calle 1"
ENVIA_ORIGIN_NUMBER="1-1"
ENVIA_ORIGIN_DISTRICT=Centro
ENVIA_ORIGIN_CITY=Fusagasuga
ENVIA_ORIGIN_STATE=CU
ENVIA_ORIGIN_POSTAL_CODE=252211

# --- Factus (sandbox: api-sandbox.factus.com.co) ---
FACTUS_ENV=sandbox
FACTUS_CLIENT_ID=
FACTUS_CLIENT_SECRET=
FACTUS_USERNAME=
FACTUS_PASSWORD=
FACTUS_NUMBERING_RANGE_ID=
FACTUS_DEFAULT_MUNICIPALITY_ID=149
FACTUS_IVA_RATE=19

# --- Plataforma ---
PLATFORM_COMMISSION_RATE=0.08
STOCK_RESERVATION_MINUTES=30
# Token Bearer para el servidor MCP (POST /api/mcp). Vacio = deshabilitado.
MCP_TOKEN=